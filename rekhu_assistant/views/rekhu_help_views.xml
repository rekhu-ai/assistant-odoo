<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rekhu_assistant_help_view_list" model="ir.ui.view">
        <field name="name">rekhu.assistant.help.list</field>
        <field name="model">rekhu.assistant.help</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="rekhu_assistant_help_view_form" model="ir.ui.view">
        <field name="name">rekhu.assistant.help.form</field>
        <field name="model">rekhu.assistant.help</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="How we handle a return"/></h1>
                    </div>
                    <field name="body" placeholder="The steps, the rules and the exceptions, in your own words. The assistant answers how-to questions from these topics."/>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rekhu_assistant_help_action" model="ir.actions.act_window">
        <field name="name">Assistant help topics</field>
        <field name="res_model">rekhu.assistant.help</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Write down how things work in your company</p>
            <p>One topic per subject: the assistant answers how-to questions from them, in the user's language.</p>
        </field>
    </record>
</odoo>
