<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- the set-up: what this Odoo holds, and where the assistant works -->
    <record id="rekhu_assistant_setup_view_form" model="ir.ui.view">
        <field name="name">rekhu.assistant.setup.form</field>
        <field name="model">rekhu.assistant.setup</field>
        <field name="arch" type="xml">
            <form string="Set up Rekhu Assistant">
                <div class="alert alert-info mb-3" role="status">
                    These are the apps installed here and the records in each. Choose where the assistant works and what it
                    may do there. It does nothing anywhere else, and every user still sees and does only what their own
                    access rights allow. Every change waits for a click on Confirm.
                </div>
                <field name="line_ids" nolabel="1">
                    <tree editable="bottom" create="0" delete="0">
                        <!-- read-only here, but sent back on save: the rule is made from them -->
                        <field name="app" force_save="1"/>
                        <field name="label" force_save="1"/>
                        <field name="records" force_save="1"/>
                        <field name="mode"/>
                        <field name="model_name" force_save="1" optional="hide"/>
                    </tree>
                </field>
                <group>
                    <field name="group_id" options="{'no_create': True}" placeholder="Every internal user"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Save and switch on" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="rekhu_assistant_setup_action" model="ir.actions.act_window">
        <field name="name">Set up Rekhu Assistant</field>
        <field name="res_model">rekhu.assistant.setup</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- right after install, Odoo opens the set-up for the administrator once -->
    <record id="rekhu_assistant_setup_todo" model="ir.actions.todo">
        <field name="action_id" ref="rekhu_assistant_setup_action"/>
        <field name="sequence">10</field>
        <field name="state">open</field>
    </record>

    <!-- the rules: where the assistant works, kept as records -->
    <record id="rekhu_assistant_scope_view_list" model="ir.ui.view">
        <field name="name">rekhu.assistant.scope.list</field>
        <field name="model">rekhu.assistant.scope</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="app"/>
                <field name="model_id" options="{'no_create': True}"/>
                <field name="mode"/>
            </tree>
        </field>
    </record>

    <record id="rekhu_assistant_scope_action" model="ir.actions.act_window">
        <field name="name">Where the assistant works</field>
        <field name="res_model">rekhu.assistant.scope</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The assistant does not work anywhere yet</p>
            <p>Run the set-up under Settings → Rekhu Assistant to choose where it works.</p>
        </field>
    </record>
</odoo>
